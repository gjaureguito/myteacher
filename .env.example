# ===== Copiá estas variables en Railway → tu servicio → Variables =====

APP_NAME=MyTeacher
APP_URL=https://www.tudominio.com          # sin barra final; usá el dominio definitivo
PLAN_PRICE=50000                            # en pesos, se cobra por mes
ADMIN_EMAILS=gjaureguito@gmail.com          # separados por coma; ven el panel /admin
CONTACT_EMAIL=contacto@tudominio.com
LEGAL_OWNER=Tu nombre o razón social

# Base de datos (en Railway: referenciá la variable del servicio MySQL)
MYSQL_URL=${{MySQL.MYSQL_URL}}

# Mercado Pago: lo ideal es cargarlo desde Admin → Mercado Pago (queda cifrado y tiene prioridad).
# Estas variables quedan como respaldo. APP_KEY cifra los secretos guardados en la base.
APP_KEY=                                    # texto largo al azar; si cambia, hay que recargar el token
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=                          # "Clave secreta" que muestra la pantalla de Webhooks

# Google (console.cloud.google.com → Credenciales → ID de cliente OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Hotmail (entra.microsoft.com → Registros de aplicaciones)
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Solo desarrollo local
# DB_DRIVER=sqlite
