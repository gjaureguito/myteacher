FROM ollama/ollama:latest AS ollama
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=ollama /bin/ollama /usr/local/bin/ollama
COPY --from=ollama /lib/ollama /lib/ollama
ENV OLLAMA_MODELS=/models OLLAMA_HOST=127.0.0.1:11434
WORKDIR /app
COPY requirements-ia.txt .
RUN pip install --no-cache-dir -r requirements-ia.txt && python -m piper.download_voices en_US-lessac-medium
COPY app-ia.py ./app.py
COPY start-ia.sh ./start.sh
RUN chmod +x /app/start.sh
CMD ["/app/start.sh"]
